{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EggplantRecorder needs the microphone when you enable microphone capture while recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你在录制时启用麦克风采集时，EggplantRecorder 需要使用麦克风。"
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EggplantRecorder needs Screen Recording access to capture displays and windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "EggplantRecorder 需要屏幕录制权限以捕获显示器和窗口。"
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EggplantRecorder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "EggplantRecorder"
          }
        }
      }
    },
